# Node connection (required). The node must be started with server=1.
# Hostname or IP of the Litecoin node.
LTC_HOST=

# rpcuser from litecoin.conf.
LTC_USER=

# rpcpassword from litecoin.conf.
LTC_PASS=

# RPC port: 9332 mainnet, 19332 testnet, 19443 regtest.
LTC_PORT=

# http, or https if the node is behind a TLS proxy.
LTC_PROTOCOL=

# Optional test settings. Leave a value blank to skip the tests that need it.
# Wallet tests run unscoped, so keep exactly one wallet loaded.

# Set to 1 to let the sendToAddress test broadcast a real transaction
# (0.0001 LTC to one of the wallet's own addresses; you only lose the fee).
LTC_TEST_SEND=

# Address the importAddress test adds to the wallet as watch-only (no rescan).
TEST_IMPORT_ADDRESS=

# Address with some history, for the address index tests.
# Needs a node started with -addressindex.
TEST_ADDRESS=

# Wallet passphrase, only if the wallet is encrypted. Signing tests unlock
# the wallet briefly and lock it again.
TEST_WALLET_PASSPHRASE=

# A txid and output index that has been spent, for the getSpentInfo test.
# Needs a node started with -spentindex. Set both or neither.
TEST_SPENT_TXID=
TEST_SPENT_INDEX=

# Wallet to send wallet calls to (e.g. A). Set it when the node has several
# wallets loaded; leave blank when only one is loaded.
TEST_WALLET=

# The named-wallet tests load extra wallets, so they only run on their own,
# from the shell (not from this file):
#   TEST_MULTIWALLET=1 npx jest tests/multi-wallet.spec.ts
